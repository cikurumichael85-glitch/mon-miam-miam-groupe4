# Modèle public, jamais remplacer ces champs par des secrets dans un dépôt.
APP_NAME="Mon Miam Miam"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://VOTRE-SERVICE.onrender.com
FRONTEND_URL=https://VOTRE-PROJET.vercel.app
APP_KEY=
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=verify-full
PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=sync
MAIL_MAILER=log
EASYPAY_ENABLED=false
DEPLOY_RUN_MIGRATIONS=false
